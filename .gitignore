# Polsia Next.js template — gitignore (Node + Next.js + tools)

# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
/out/
next-env.d.ts

# Production builds
/build/
/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env files: never commit .env*
# Block every .env* variant (.env, .env.local, .env.production, .env.staging, …)
# and keep only the committed .env.example documenting the shape.
.env*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
/coverage/

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Polsia upgrade reconcile sidecars (never commit)
*.polsia-app-old

# Local Superpowers planning artifacts: never commit
/docs/superpowers/

# Temporary Android build toolchain and signing material
/.android-build/
/android/.keys/
/android/build/
/android/app/build/
/android/.gradle/
/android/.android-user/
/android/local.properties
/ios/build/
/solco.aab

# Materiale di firma Apple: MAI nel repo. Con App Store Connect API key la chiave .p8
# va nei GitHub Secrets (in base64), non in un file. Rete di sicurezza contro drop accidentali.
*.p8
*.p12
*.cer
*.mobileprovision
*.certSigningRequest

# Python bytecode cache (dagli script locali in scripts/)
__pycache__/
*.pyc

# Binario compilato dello strumento Go locale (scripts/solco-cc-dl)
/scripts/solco-cc-dl/solco-cc-dl

# Python bytecode from tools/ (e.g. tools/tiktok-ad/render.py)
__pycache__/

# Personal Claude Code overrides — keep out of the repo.
.claude/settings.local.json
