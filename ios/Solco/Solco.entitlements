<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Domini associati: i link a www.solcomusic.online aprono l'app (Universal Links) e Safari e l'app
     condividono le credenziali salvate. Il sito risponde in /.well-known/apple-app-site-association
     quando APPLE_TEAM_ID è impostato su Vercel. La firma automatica di Xcode attiva la capability
     sull'App ID; nei build senza firma il file non ha effetto. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.solcomusic.online</string>
		<string>webcredentials:www.solcomusic.online</string>
	</array>
</dict>
</plist>
