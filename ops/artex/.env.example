# ops/artex/.env.example — copy to .env on the VPS and fill in.
# Never commit the real .env. .gitignore excludes it.

# ----- the only authorized target --------------------------------------------
# The staging preview of Solco. Exactly the host Vercel printed, no scheme, no
# path. The bootstrap script writes scope.json from this value.
# The default below is the live staging preview for the current branch; override
# it when a different staging URL is in use.
ARTEX_TARGET_HOST=mr120712-git-claude-huggingface-deepseek-spac-60b7de-solcomusic.vercel.app

# The public hostname Caddy fetches a Let's Encrypt cert for. An A record on
# this name must point at the VPS IPv4 (solcomusic.online DNS on Vercel does).
# If the VPS IP ever changes, update the A record in Vercel DNS and this stays.
ARTEX_PUBLIC_HOST=artex.solcomusic.online

# ----- UI binding and local access ------------------------------------------
# Localhost only. Reach the UI over SSH tunnel; see tunnel.md.
ARTEX_BIND_ADDR=127.0.0.1

# ----- Postgres --------------------------------------------------------------
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ----- LLM provider ---------------------------------------------------------
# DEFAULT MODE: route the planner through the local Claude Agent SDK bridge
# sibling (see ops/artex/claude-bridge/), which is backed by the user's Claude
# Code subscription instead of a pay-per-token API key. Compose wires
# ARTEX_LLM_BASE_URL=http://claude-bridge:5000 for you; the api key below is a
# placeholder because ARTEX requires one non-empty but the bridge ignores its
# value. Run `docker compose exec claude-bridge claude login` once on first
# boot to attach the container to your Claude Code account.
ANTHROPIC_API_KEY=dummy-bridge-key
ARTEX_LLM_PROVIDER=anthropic
ARTEX_LLM_MODEL=claude-opus-4-7
# The bridge supports both streaming and non-streaming now. Non-streaming is
# the default we ship (smaller surface for first debug); set to true for SSE.
ARTEX_LLM_STREAM=false
# Bridge rate limits. The local limiter BLOCKS (waits in-flight) rather than
# refusing a 429 to ARTEX, so there's no per-call penalty for keeping these
# low -- it just paces the stream. Defaults: 0.5 rps, 1 in-flight (strictly
# serial). Raise only if your subscription window can clearly absorb more.
BRIDGE_MAX_RPS=0.5
BRIDGE_MAX_CONCURRENCY=1

# Upstream (Claude Code subscription) rate-limit retry policy. The bridge
# prefers an HONEST wait whenever the SDK hands us the real resets_at
# timestamp (five_hour / seven_day windows) — it sleeps until the window
# opens, not longer. Exp backoff below only fires when no resets_at is
# available OR the reset is beyond the single-wait cap.
#   attempts: total tries (first failure counts as attempt 1).
#   base/cap: exp backoff bounds between attempts when there is no
#     usable resets_at. 5->10->20->40->60->60->60->60->60->60s ~ 5 min.
#   reset_wait_cap: single-wait ceiling when resets_at IS present.
#     Default 6h rides out a five_hour window fully; a seven_day window
#     sits beyond and falls back to exp backoff instead of hanging for days.
# After all attempts the bridge returns 429 so ARTEX can decide; with
# unlimited budgets ARTEX just retries.
BRIDGE_UPSTREAM_RETRY_ATTEMPTS=10
BRIDGE_UPSTREAM_RETRY_BASE_SECONDS=5
BRIDGE_UPSTREAM_RETRY_CAP_SECONDS=60
BRIDGE_RESET_WAIT_CAP_SECONDS=21600

# ----- Optional fallback chain ----------------------------------------------
# On the first SubscriptionRateLimited from the primary (Claude Code
# subscription), the bridge walks THIS chain in order. First link that
# answers wins. If every link also rate-limits, it falls back to
# wait-until-reset / exp backoff. Every key lives in process env ONLY;
# nothing ever appears in logs.
#
# Order: Omniroute first, FreeLLMAPI second, direct Anthropic last. Each
# link is OPT-IN -- skip a link by leaving its API key unset.
#
# OmniRoute sibling (https://github.com/cheaper-inference/OmniRoute).
# Runs as a sibling container in this compose. First boot: SSH-tunnel 20128,
# open http://127.0.0.1:20128, finish the onboarding wizard (dashboard
# password + BOOTSTRAP token from `docker logs artex-omniroute | grep BOOTSTRAP`),
# connect providers in Dashboard -> Providers, create an API key in
# Dashboard -> API Manager, and paste it here. See ops/artex/README.md.
# MODEL=auto lets OmniRoute pick the best connected provider for each call;
# use auto/coding or auto/smart for planner-heavier runs.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_MODEL=auto
OMNIROUTE_AUTH_SCHEME=Bearer
OMNIROUTE_PATH=/v1/chat/completions
OMNIROUTE_TIMEOUT_SECONDS=300

# Optional: pre-seed the OmniRoute dashboard password so the wizard skips
# step 1. An empty value behaves like unset (wizard will prompt).
OMNIROUTE_INITIAL_PASSWORD=
# Optional: a public origin if you ever front OmniRoute with its own Caddy site.
OMNIROUTE_PUBLIC_URL=
OMNIROUTE_MEMORY_MB=2048

# FreeLLMAPI (OpenAI-compatible: /v1/chat/completions).
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=
FREELLMAPI_AUTH_SCHEME=Bearer
FREELLMAPI_PATH=/v1/chat/completions
FREELLMAPI_TIMEOUT_SECONDS=300

# OpenAI direct (pay-per-token at platform.openai.com; API has no training
# on API data per their policy). Default model gpt-5-codex -- coding and
# tool-use specialized, better fit for ARTEX than plain GPT-5. Override
# OPENAI_MODEL if you want gpt-5 / gpt-5-mini / gpt-4.1 / o-series instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5-codex
OPENAI_AUTH_SCHEME=Bearer
OPENAI_PATH=/v1/chat/completions
OPENAI_TIMEOUT_SECONDS=300

# Direct Anthropic API (last link; pay-per-token backstop at console.anthropic.com).
ANTHROPIC_FALLBACK_API_KEY=

BRIDGE_CACHE_TTL_SECONDS=3600

# Alternative: direct pay-per-token API, bypassing the bridge. Uncomment and
# set ARTEX_LLM_BASE_URL= (empty) to point ARTEX at Anthropic/OpenAI directly.
# ANTHROPIC_API_KEY=sk-ant-...
# ARTEX_LLM_BASE_URL=
# OPENAI_API_KEY=
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_MODEL=gpt-5

# ----- safety brakes (do not raise without reason) --------------------------
# Quiet noise: 2 req/s per host, 1 in flight. Even on your own preview, this
# surfaces real latency bugs rather than burying them in a stampede.
ARTEX_NOISE_PROFILE=quiet

# Per-task and per-intent LLM budgets. ARTEX treats any value <= 0 (empty
# counts as 0) as Unlimited -- see agent/budget.go#budgetCap. When BOTH task
# and intent are (0,0) the whole ledger is nil and there's no in-flight
# accounting. This bundle routes the planner through the subscription-backed
# claude-bridge (not pay-per-token), so there's no $ ceiling to protect; the
# real limiter is the subscription rate window, which the bridge surfaces as
# 429s that ARTEX backs off from. Default: unlimited. Set a positive integer
# only if you point ARTEX at a direct Anthropic/OpenAI key and need a hard
# spend cap.
ARTEX_TASK_BUDGET_TOKENS=0
ARTEX_TASK_BUDGET_TURNS=0
ARTEX_INTENT_BUDGET_TOKENS=0
ARTEX_INTENT_BUDGET_TURNS=0

# User-Agent so your staging logs can filter ARTEX traffic clearly.
# Quoted because the value has parens/space/semicolon — bootstrap.sh sources
# .env with bash, which otherwise reads `(…)` as a subshell. docker-compose
# strips the surrounding quotes on load, so both shells see the same string.
ARTEX_TARGET_USER_AGENT="ARTEX-solco-staging (+authorized self-test; owner mr120712)"

# ----- off on purpose -------------------------------------------------------
# No GitHub ping.
ARTEX_UPDATE_CHECK=
# Untrusted-output framing on (default).
ARTEX_UNTRUSTED_BOUNDARY=

# ----- Better Auth gateway --------------------------------------------------
# The single admin's username (what you type at /login). Alphanumeric or
# underscore, 2-64 chars.
GATEWAY_ADMIN_USERNAME=admin

# The admin's password. 4-128 chars. Pick a strong one — this is the only
# gate between the internet and the ARTEX console. Rotating is edit + restart:
# `docker compose up -d --force-recreate gateway` re-hashes the stored value.
GATEWAY_ADMIN_PASSWORD=

# Cookie-signing secret for Better Auth sessions. Rotate with:
#   openssl rand -hex 32
# Rotating this invalidates every active session on every device.
GATEWAY_BETTER_AUTH_SECRET=

# The ARTEX admin password you chose on /setup. The gateway uses it to
# auto-login into ARTEX on behalf of the single authenticated user, so the
# ARTEX /login screen is never shown. Must match whatever you typed on
# /setup; if you rotate the ARTEX password later, update this and
# `docker compose up -d --force-recreate gateway`.
ARTEX_SESSION_PASSWORD=
