# ops/artex/.env.example — copy to .env on the VPS and fill in.
# Never commit the real .env. .gitignore excludes it.

# ----- the only authorized target --------------------------------------------
# The staging preview of Solco. Exactly the host Vercel printed, no scheme, no
# path. The bootstrap script writes scope.json from this value.
# The default below is the live staging preview for the current branch; override
# it when a different staging URL is in use.
ARTEX_TARGET_HOST=mr120712-git-claude-huggingface-deepseek-spac-60b7de-solcomusic.vercel.app

# The sslip.io hostname Caddy fetches a Let's Encrypt cert for. Encodes this
# VPS's public IPv4. If the VPS IP ever changes, update this too.
# Format: <A>-<B>-<C>-<D>.sslip.io
ARTEX_PUBLIC_HOST=5-222-15-32.sslip.io

# ----- UI binding and local access ------------------------------------------
# Localhost only. Reach the UI over SSH tunnel; see tunnel.md.
ARTEX_BIND_ADDR=127.0.0.1

# ----- Postgres --------------------------------------------------------------
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ----- LLM provider (pick one; fill the matching key) -----------------------
# For Anthropic:
ANTHROPIC_API_KEY=
ARTEX_LLM_PROVIDER=anthropic
ARTEX_LLM_MODEL=claude-opus-4-7
# For OpenAI (comment the Anthropic block and uncomment these):
# OPENAI_API_KEY=
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_MODEL=gpt-5

# ----- safety brakes (do not raise without reason) --------------------------
# Quiet noise: 2 req/s per host, 1 in flight. Even on your own preview, this
# surfaces real latency bugs rather than burying them in a stampede.
ARTEX_NOISE_PROFILE=quiet

# One task can't run away with LLM spend.
ARTEX_TASK_BUDGET_TOKENS=200000
ARTEX_TASK_BUDGET_TURNS=120
ARTEX_INTENT_BUDGET_TOKENS=60000
ARTEX_INTENT_BUDGET_TURNS=30

# User-Agent so your staging logs can filter ARTEX traffic clearly.
ARTEX_TARGET_USER_AGENT=ARTEX-solco-staging (+authorized self-test; owner mr120712)

# ----- off on purpose -------------------------------------------------------
# No GitHub ping.
ARTEX_UPDATE_CHECK=
# Untrusted-output framing on (default).
ARTEX_UNTRUSTED_BOUNDARY=
