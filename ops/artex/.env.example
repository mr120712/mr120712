# ops/artex/.env.example — copy to .env on the VPS and fill in.
# Never commit the real .env. .gitignore excludes it.

# ----- the only authorized target --------------------------------------------
# The staging preview of Solco. Exactly the host Vercel printed, no scheme, no
# path. The bootstrap script writes scope.json from this value.
# The default below is the live staging preview for the current branch; override
# it when a different staging URL is in use.
ARTEX_TARGET_HOST=mr120712-git-claude-huggingface-deepseek-spac-60b7de-solcomusic.vercel.app

# The public hostname Caddy fetches a Let's Encrypt cert for. An A record on
# this name must point at the VPS IPv4 (solcomusic.online DNS on Vercel does).
# If the VPS IP ever changes, update the A record in Vercel DNS and this stays.
ARTEX_PUBLIC_HOST=artex.solcomusic.online

# ----- UI binding and local access ------------------------------------------
# Localhost only. Reach the UI over SSH tunnel; see tunnel.md.
ARTEX_BIND_ADDR=127.0.0.1

# ----- Postgres --------------------------------------------------------------
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ----- LLM provider ---------------------------------------------------------
# DEFAULT MODE: route the planner through the local Claude Agent SDK bridge
# sibling (see ops/artex/claude-bridge/), which is backed by the user's Claude
# Code subscription instead of a pay-per-token API key. Compose wires
# ARTEX_LLM_BASE_URL=http://claude-bridge:5000 for you; the api key below is a
# placeholder because ARTEX requires one non-empty but the bridge ignores its
# value. Run `docker compose exec claude-bridge claude login` once on first
# boot to attach the container to your Claude Code account.
ANTHROPIC_API_KEY=dummy-bridge-key
ARTEX_LLM_PROVIDER=anthropic
# Where ARTEX sends LLM calls. For bridge mode keep this pointed at the sibling
# container. For DIRECT mode (see the OpenAI block lower down) set it EMPTY —
# compose then lets it through empty and ARTEX calls the provider's public
# endpoint. The bridge only speaks Anthropic's /v1/messages, so OpenAI-format
# traffic must NOT go here.
ARTEX_LLM_BASE_URL=http://claude-bridge:5000
# COST: the cheapest tier is the default. The planner fires many calls per task,
# and Haiku costs ~20x less (subscription window AND pay-per-token) than Opus.
# Bump to claude-sonnet-4-5 for stronger planning, claude-opus-4-7 for the
# strongest/most expensive. The bridge floors this anyway (BRIDGE_MODEL_OVERRIDE).
ARTEX_LLM_MODEL=claude-haiku-4-5
# The bridge supports both streaming and non-streaming now. Non-streaming is
# the default we ship (smaller surface for first debug); set to true for SSE.
ARTEX_LLM_STREAM=false
# Prompt caching (ARTEX P3.5 phase C). Keeps the worker system-prompt's large
# static prefix byte-identical across calls so the provider's prompt cache can
# hit it — cheap cache reads instead of full-price input on every planner call.
# Biggest win in pay-per-token direct mode (gpt-5-mini / Anthropic). 1 = on
# (our default), 0 = legacy layout. See the prompt-caching notes in README.md.
ARTEX_CACHE_PREFIX=1
# Bridge rate limits. Tune these up only if you know your subscription window
# can absorb more; ARTEX can call the planner many times per task.
BRIDGE_MAX_RPS=1.0
BRIDGE_MAX_CONCURRENCY=2
# 24h prompt cache: identical probes/retries within a day are free.
BRIDGE_CACHE_TTL_SECONDS=86400
# COST FLOOR (centralized in the bridge): rewrite whatever model ARTEX asks for
# to this cheap tier before hitting the subscription — a hard spend guard that
# does not require editing ARTEX's own config. Leave empty to honor ARTEX's
# ARTEX_LLM_MODEL request verbatim.
BRIDGE_MODEL_OVERRIDE=claude-haiku-4-5
# Optional selective downgrade instead of a blanket override — JSON object
# {requested_model: cheaper_model}. OVERRIDE wins when both are set. Example:
# BRIDGE_MODEL_MAP={"claude-opus-4-7":"claude-haiku-4-5","claude-sonnet-4-5":"claude-haiku-4-5"}
BRIDGE_MODEL_MAP=

# ----- OpenAI DIRECT mode (pay-per-token, bypasses the bridge) ---------------
# Point ARTEX straight at OpenAI instead of the subscription bridge. To switch:
#   1. ARTEX_LLM_BASE_URL=            # EMPTY -> ARTEX calls api.openai.com direct
#   2. OPENAI_API_KEY=sk-...          # a real key; put it ONLY here, never in git
#   3. pick ONE provider+model pair below
#   4. ANTHROPIC_API_KEY can stay the dummy; it's ignored once the provider is
#      openai/openai-responses. (`bootstrap.sh` does all of this for you if you
#      answer "openai" or "openai-responses" to the provider prompt.)
#
# WHICH PROVIDER: it decides the wire format ARTEX uses.
#   • GPT-5 / o-series (reasoning models): use openai-responses. They REJECT the
#     old Chat Completions `max_tokens` field (unsupported_parameter), so plain
#     `openai` fails — the Responses API is required. gpt-5-mini is the sane
#     default (the planner makes many calls; mini is far cheaper). gpt-5 and
#     gpt-5-pro are stronger but several times the per-token price.
#       ARTEX_LLM_PROVIDER=openai-responses
#       ARTEX_LLM_MODEL=gpt-5-mini     # or gpt-5 / gpt-5-pro for more power
#   • gpt-4o / gpt-4.1 / other non-reasoning: use openai (Chat Completions).
#       ARTEX_LLM_PROVIDER=openai
#       ARTEX_LLM_MODEL=gpt-4o
#
# COST WARNING: direct mode has NO bridge floor/cache. Every planner call is
# billed per-token. The ARTEX_TASK_BUDGET_* brakes below are your only guard —
# keep them tight, and prefer a cheaper model for broad sweeps.
#
# Anthropic direct (real sk-ant- key, no bridge) is the same recipe with
# ARTEX_LLM_PROVIDER=anthropic + a real ANTHROPIC_API_KEY + empty base URL.

# ----- safety brakes (do not raise without reason) --------------------------
# Quiet noise: 2 req/s per host, 1 in flight. Even on your own preview, this
# surfaces real latency bugs rather than burying them in a stampede.
ARTEX_NOISE_PROFILE=quiet

# One task can't run away with LLM spend. Tightened for the low-cost profile;
# raise if Haiku genuinely needs more steps for a target.
ARTEX_TASK_BUDGET_TOKENS=150000
ARTEX_TASK_BUDGET_TURNS=80
ARTEX_INTENT_BUDGET_TOKENS=45000
ARTEX_INTENT_BUDGET_TURNS=20

# User-Agent so your staging logs can filter ARTEX traffic clearly.
# Quoted because the value has parens/space/semicolon — bootstrap.sh sources
# .env with bash, which otherwise reads `(…)` as a subshell. docker-compose
# strips the surrounding quotes on load, so both shells see the same string.
ARTEX_TARGET_USER_AGENT="ARTEX-solco-staging (+authorized self-test; owner mr120712)"

# ----- off on purpose -------------------------------------------------------
# No GitHub ping.
ARTEX_UPDATE_CHECK=
# Untrusted-output framing on (default).
ARTEX_UNTRUSTED_BOUNDARY=
