# ops/artex/.env.example — copy to .env on the VPS and fill in.
# Never commit the real .env. .gitignore excludes it.

# ----- the only authorized target --------------------------------------------
# The staging preview of Solco. Exactly the host Vercel printed, no scheme, no
# path. The bootstrap script writes scope.json from this value.
# The default below is the live staging preview for the current branch; override
# it when a different staging URL is in use.
ARTEX_TARGET_HOST=mr120712-git-claude-huggingface-deepseek-spac-60b7de-solcomusic.vercel.app

# The public hostname Caddy fetches a Let's Encrypt cert for. An A record on
# this name must point at the VPS IPv4 (solcomusic.online DNS on Vercel does).
# If the VPS IP ever changes, update the A record in Vercel DNS and this stays.
ARTEX_PUBLIC_HOST=artex.solcomusic.online

# ----- UI binding and local access ------------------------------------------
# Localhost only. Reach the UI over SSH tunnel; see tunnel.md.
ARTEX_BIND_ADDR=127.0.0.1

# ----- Postgres --------------------------------------------------------------
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ----- LLM provider (pick one; fill the matching key) -----------------------
# For Anthropic:
ANTHROPIC_API_KEY=
ARTEX_LLM_PROVIDER=anthropic
ARTEX_LLM_MODEL=claude-opus-4-7
# For OpenAI (comment the Anthropic block and uncomment these):
# OPENAI_API_KEY=
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_MODEL=gpt-5

# ----- the llm-shim: reliability proxy (optional) ---------------------------
# An OpenAI-compatible proxy that (a) strips reasoning_content from requests
# (reasoning models emit it, ARTEX echoes it, strict upstreams 400), and
# (b) fails over across backends on TRANSIENT errors only (429/5xx/timeouts) —
# a safety refusal and config errors pass straight through, never rerouted.
# Backends + real keys live in llm-shim/backends.json (gitignored), NOT here.
# Enable it:
#   1) cp llm-shim/backends.example.json llm-shim/backends.json  (fill keys,
#      order = failover priority, e.g. Anthropic claude-opus-5-5 then OpenAI/Groq)
#   2) point ARTEX at the shim and give it a dummy key (real keys are in
#      backends.json; the shim swaps in the per-backend key):
#        ARTEX_LLM_PROVIDER=openai
#        ARTEX_LLM_BASE_URL=http://llm-shim:8080/v1
#        OPENAI_API_KEY=dummy
#   3) docker compose --profile llm-shim up -d --build
#      docker compose up -d --force-recreate artex

# ----- safety brakes (do not raise without reason) --------------------------
# Quiet noise: 2 req/s per host, 1 in flight. Even on your own preview, this
# surfaces real latency bugs rather than burying them in a stampede.
ARTEX_NOISE_PROFILE=quiet

# One task can't run away with LLM spend.
ARTEX_TASK_BUDGET_TOKENS=200000
ARTEX_TASK_BUDGET_TURNS=120
ARTEX_INTENT_BUDGET_TOKENS=60000
ARTEX_INTENT_BUDGET_TURNS=30

# User-Agent so your staging logs can filter ARTEX traffic clearly.
# Quoted because the value has parens/space/semicolon — bootstrap.sh sources
# .env with bash, which otherwise reads `(…)` as a subshell. docker-compose
# strips the surrounding quotes on load, so both shells see the same string.
ARTEX_TARGET_USER_AGENT="ARTEX-solco-staging (+authorized self-test; owner mr120712)"

# ----- edge auth (Caddy basic auth in front of ARTEX's JWT) -----------------
# The console is internet-facing (Caddy :443), so a second gate sits in front
# of ARTEX's own JWT login. /api/health stays open; everything else needs this.
# Generate a hash (pick a strong password; it is NOT echoed or stored):
#   docker compose run --rm caddy caddy hash-password --plaintext 'your-strong-pass'
# Then paste the $2b$... output below, SINGLE-QUOTED (it contains '$'), and
# `docker compose up -d caddy`. Leave both empty to keep the console LOCKED
# (fail-closed default) while /api/health stays reachable.
ARTEX_UI_USER=artex
ARTEX_UI_PASSWORD_HASH=

# ----- off on purpose -------------------------------------------------------
# No GitHub ping.
ARTEX_UPDATE_CHECK=
# Untrusted-output framing on (default).
ARTEX_UNTRUSTED_BOUNDARY=
