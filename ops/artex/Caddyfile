# ops/artex/Caddyfile — public TLS + reverse proxy for the ARTEX gateway.
#
# What this does:
#   • Terminates TLS on :443 with a free Let's Encrypt cert for ARTEX_PUBLIC_HOST
#     (e.g. artex.solcomusic.online).
#   • Reverse-proxies to the Better Auth gateway (ops/artex/gateway/) on port
#     3000 of the compose network. The gateway, in turn, enforces Better Auth
#     magic-link before rewriting authenticated traffic to ARTEX at
#     artex:8787.
#   • Does NOT add its own basic-auth. The gateway is the single source of
#     authentication: having two prompts (Caddy basic-auth + Better Auth)
#     weakens the model by giving operators a reason to share credentials.
#   • Strips the Server header so scanners can't trivially see Caddy's version.
#
# To change the public hostname, edit .env (ARTEX_PUBLIC_HOST=...) and
# `docker compose up -d --force-recreate caddy`.

{
	# Dial out for Let's Encrypt from the container; no admin API exposed.
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$ARTEX_PUBLIC_HOST} {
	encode gzip
	header -Server

	reverse_proxy http://gateway:3000 {
		transport http {
			dial_timeout 5s
			# Long response timeout covers SSE streams the gateway forwards
			# from ARTEX (live task updates). ARTEX itself streams, so
			# buffering here would stall the UI.
			response_header_timeout 120s
		}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# Flush straight through so SSE doesn't buffer upstream of the client.
		flush_interval -1
	}
}
