{
  "name": "@mr120712/artex-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Better Auth magic-link gateway in front of ARTEX. Terminates auth before any request reaches the upstream ARTEX API.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.28",
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prisma": "6.19.3",
    "tsx": "4.19.3",
    "typescript": "5.5.4"
  }
}
