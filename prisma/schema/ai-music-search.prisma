// @polsia:user-owned — piani della ricerca AI (Claude) per descrizione, riusati per 7 giorni:
// la stessa richiesta non viene pagata due volte. Ogni piano è legato a chi l'ha chiesto
// (cancellato con l'account), tranne quelli degli esempi pronti, condivisi da tutti.
model AiMusicSearchCache {
  key       String   @id
  userId    String?
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}
