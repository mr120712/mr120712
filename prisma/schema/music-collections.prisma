// @polsia:user-owned
model UserMusicCollection {
  id        String                    @id @default(cuid())
  userId    String
  name      String
  kind      String
  /// Cartella della Libreria (UserMusicFolder.id) che contiene la playlist; null = radice.
  folderId  String?
  /// Link pubblico /playlist/<shareId> (16 byte casuali in base64url), creato solo quando la
  /// playlist viene condivisa; null = privata. Smettere di condividere lo azzera.
  /// Indice semplice, non @unique: con `prisma db push` senza --accept-data-loss (il comando di
  /// build su Vercel) un nuovo vincolo unico blocca il deploy. L'unicità la garantisce il codice
  /// (id casuali a 128 bit e controllo prima di assegnarli).
  shareId   String?
  sharedAt  DateTime?
  /// Sorgente Spotify da cui la playlist è stata importata/sincronizzata: 'saved' per i brani
  /// salvati, 'playlist:<id>' per una playlist. null = non importata da Spotify. L'"Aggiorna da
  /// Spotify" ritrova per questa chiave la stessa playlist e la risincronizza (specchio esatto)
  /// invece di crearne una nuova. Indice NON unico (come shareId): un nuovo vincolo unico
  /// bloccherebbe `prisma db push` sul deploy; l'unicità per (userId, spotifySource) la garantisce
  /// il codice.
  spotifySource String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  items     UserMusicCollectionItem[]

  @@unique([userId, name])
  @@index([userId, kind])
  @@index([folderId])
  @@index([shareId])
  @@index([userId, spotifySource])
}

model UserMusicCollectionItem {
  id              String             @id @default(cuid())
  collectionId    String
  collection      UserMusicCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source          String
  sourceId        String
  title           String?
  creatorName     String?
  artworkUrl      String?
  sourceUrl       String?
  artistUrl       String?
  durationSeconds Int?
  createdAt       DateTime           @default(now())
  expiresAt       DateTime?

  @@unique([collectionId, source, sourceId])
  @@index([source, expiresAt])
}
