// @polsia:user-owned — libreria PUBBLICA di brani caricati dagli utenti.
// Il file audio è ospitato su Vercel Blob come oggetto PUBBLICO (servito dalla CDN via URL):
// chiunque può ascoltarlo. Nasce visibile con l'attestazione dei diritti al caricamento; la
// moderazione (segnalazioni di utenti distinti oltre una soglia) lo ritira automaticamente, e
// l'autore può rimuoverlo in ogni momento (cancellando anche l'oggetto su Blob).

model PublicUpload {
  id                    String   @id @default(cuid())
  uploaderUserId        String
  title                 String
  artist                String?
  // URL pubblico dell'oggetto su Vercel Blob (CDN). Unico: due righe non rivendicano lo stesso file.
  blobUrl               String   @unique
  // Percorso dell'oggetto su Blob: serve per cancellarlo (del) alla rimozione. Unico.
  blobPathname          String   @unique
  mimeType              String
  byteLength            Int
  durationSeconds       Int
  // Pubblico per scelta: nasce visibile. La moderazione può ritirarlo.
  published             Boolean  @default(true)
  playCount             Int      @default(0)
  createdAt             DateTime @default(now())
  // Testo del brano (facoltativo): LRC sincronizzato o testo semplice, al massimo 20 000 caratteri
  // dopo la normalizzazione. Si mostra nel player SOLO se l'autore conferma di averne i diritti
  // (lyricsRightsConfirmed) e il brano è pubblicato. Colonne nullable/con default: compatibili.
  lyrics                String?
  lyricsRightsConfirmed Boolean  @default(false)

  reports PublicUploadReport[]
  // Solo relazione (nessuna colonna): gli ascolti contati per la classifica, uno al giorno per
  // ascoltatore.
  plays   PublicUploadPlay[]

  @@index([published, playCount])
  @@index([uploaderUserId, createdAt])
}

// Una segnalazione per utente e per brano: il conteggio è di segnalatori DISTINTI, così nessuno
// può ritirare da solo un brano ripetendo la segnalazione.
model PublicUploadReport {
  id             String   @id @default(cuid())
  uploadId       String
  reporterUserId String
  createdAt      DateTime @default(now())

  upload PublicUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, reporterUserId])
  @@index([uploadId])
}

// Un ascolto CONTATO nella classifica «Brani più ascoltati dalla community»: al massimo uno per
// ascoltatore, per brano, per giorno di calendario in Italia (Europe/Rome), così ripetere la
// richiesta non gonfia playCount. listenerKey è un HMAC-SHA256 (esadecimale, chiave derivata da un
// segreto del server) di "<giorno>|<id brano>|u:<id utente>" (o, senza accesso, "net:<rete>"):
// pseudonima e diversa per ogni brano e giorno, così le righe di una persona non si collegano tra
// loro; in questa tabella non finiscono MAI l'IP o l'id utente in chiaro. La pulizia giornaliera
// cancella le righe più vecchie di circa 35 giorni. Tabella NUOVA: compatibile con `prisma db push`.
model PublicUploadPlay {
  id          String   @id @default(cuid())
  uploadId    String
  listenerKey String
  // Giorno dell'ascolto a Roma, "YYYY-MM-DD".
  day         String
  createdAt   DateTime @default(now())

  upload PublicUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  // L'indice unico (che inizia da uploadId) serve anche alla cancellazione a cascata.
  @@unique([uploadId, listenerKey, day])
  @@index([createdAt])
}
