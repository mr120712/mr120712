// @polsia:user-owned — «Skynet»: la sentinella che ogni minuto guarda Solco (src/lib/skynet/).
// Avvisa; sul firewall di Vercel fa solo due cose, scelte dal proprietario: la verifica del browser
// per i recidivi (cacciatore) e il ripristino delle protezioni che trova spente (autodifesa).

/// Stato corrente della sentinella: una sola riga (id "main").
model SkynetState {
  id              String    @id
  updatedAt       DateTime
  /// Problemi visti di fila: { "<chiave>": giri consecutivi } (src/lib/skynet/signals.ts)
  streaks         Json
  /// Giri consecutivi senza problemi confermati, per chiudere un incidente senza sbalzi
  calmStreak      Int       @default(0)
  /// Incidente aperto: da quando e con quali problemi confermati
  incidentSince   DateTime?
  incidentKeys    String[]  @default([])
  lastNotifiedAt  DateTime?
  /// Ultima versione del firewall di Vercel vista, per accorgersi delle modifiche
  firewallVersion Int?
  /// Ultimi segnali letti (SkynetSignals), per il pannello di amministrazione
  lastSignals     Json?
  /// Cosa Skynet ha imparato dagli attacchi (LearnedDefense, src/lib/skynet/learning.ts): statistiche
  /// aggregate (niente indirizzi IP) per regolare da solo le soglie di difesa, dentro limiti fissi.
  learning        Json?
  /// Autodifesa (AutodefenseState, src/lib/skynet/autodefense.ts): cosa Skynet ha visto acceso,
  /// ripristini, tentativi e fermi. La scrive solo la sentinella.
  defense            Json?
  /// Indirizzi dell'owner da non mandare mai alla verifica: { "<ip>": "<scadenza ISO>" }. Li scrive
  /// /api/admin/skynet/trust-me quando un amministratore verificato apre /admin (7 giorni ciascuno).
  trustedIps         Json?
  /// Autodifesa in pausa fino a qui, per scelta del proprietario. La scrive solo la chat di Skynet.
  defensePausedUntil DateTime?
  /// Ultimo «riprendi autodifesa» del proprietario: i fermi di prima non valgono più.
  defenseResumedAt   DateTime?
  /// Un solo giro alla volta: chi lo prende lo tiene fino a qui (giri che si sovrappongono)
  lockedUntil     DateTime?
}

/// Diario della sentinella: incidenti, aggiornamenti, promemoria, risoluzioni, modifiche al firewall,
/// verifiche del cacciatore, motore post-quantistico, autodifesa.
model SkynetEvent {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  /// incident | update | reminder | resolved | change | hunt | quantum | defense
  kind     String
  /// critical | warning | info
  severity String
  title    String
  report   String
  /// Chiavi dei problemi (es. ["ddos", "site-down"])
  keys     String[] @default([])
  /// A quante chat Telegram è arrivato l'avviso
  notified Int      @default(0)

  @@index([at])
}
