// @polsia:user-owned — abbonamenti Solco pagati con Stripe Checkout sull'account Stripe del titolare.
model SolcoSubscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  period               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// First invoice verified as paid on Stripe (amount > 0): counts for referral rewards.
  firstPaidAt          DateTime?
  checkedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
}

/// Piani di fatturazione creati una volta sull'account PayPal (prodotto + piano per prezzo).
model PayPalBillingPlan {
  id           String   @id @default(cuid())
  key          String   @unique
  paypalPlanId String
  createdAt    DateTime @default(now())
}

model PayPalSubscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  period               String
  paypalSubscriptionId String    @unique
  status               String
  nextBillingAt        DateTime?
  /// First payment verified on PayPal (last_payment amount > 0): counts for referral rewards.
  firstPaidAt          DateTime?
  checkedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
}
