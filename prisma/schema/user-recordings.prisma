// @polsia:user-owned — brani registrati dall'utente sul sito. Il file audio è ospitato
// interamente su Solco (uploadPrivateFile). PRIVATO di default: servito solo al proprietario.
// Se l'utente lo PUBBLICA (published), entra nella classifica community ed è ascoltabile dagli
// utenti loggati; resta ritirabile in ogni momento e si auto-ritira oltre la soglia di segnalazioni.

model UserRecording {
  id              String   @id @default(cuid())
  userId          String
  title           String
  // Chiave del file privato in archivio (Polsia R2). Unica: due righe non possono
  // rivendicare lo stesso oggetto.
  fileKey         String   @unique
  mimeType        String
  byteLength      Int
  durationSeconds Int
  // Pubblicazione esplicita per la classifica community (privato di default).
  published       Boolean   @default(false)
  publishedAt     DateTime?
  // Segnalazioni ricevute: oltre la soglia il brano si auto-ritira dalla classifica.
  reports         Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([published, publishedAt])
}
