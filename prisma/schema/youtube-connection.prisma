// @polsia:user-owned
/// Collegamento fra un account Solco e il suo account YouTube/Google (Authorization Code + PKCE,
/// client confidenziale). accessToken e refreshToken sono cifrati (AES-256-GCM, formato
/// "v1.<iv>.<ct>"), mai in chiaro. Nessuna relazione con User: la cancellazione dell'account e
/// "Disconnetti YouTube" eliminano la riga in modo esplicito. Nessun contenuto YouTube salvato qui.
model YouTubeConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("youtube_connection")
}
