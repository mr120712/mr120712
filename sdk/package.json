{
  "name": "@solco/sdk",
  "version": "0.1.0",
  "description": "Client SDK tipizzato per l'API di Solco (musica, ricerca, radio, podcast, stato e download offline).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir .test-dist && node --test \".test-dist/test/*.test.js\"",
    "clean": "rm -rf dist .test-dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "solco",
    "music",
    "audius",
    "sdk",
    "api-client"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
