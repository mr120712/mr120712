{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && { ( export DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\"; npx prisma db push --skip-generate || npx prisma db push --skip-generate ) ; npm run build ; }",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/apple-music",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "41 5 * * *"
    }
  ]
}
