{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "solco": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run db:generate && NODE_OPTIONS=--max-old-space-size=7168 npm run build"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/apple-music",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "tdm-reservation",
          "value": "1"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "41 5 * * *"
    },
    {
      "path": "/api/cron/skynet",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/telegram-webhook",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/cron/ytdlp-keepwarm",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "solco"
      }
    }
  ]
}
